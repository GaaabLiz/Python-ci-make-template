  <diagram id="template-context-cleanup" name="4 · Template setup">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="template-title" value="One-time cleanup after template creation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontColor=#111827;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="80" y="28" width="1000" height="42" as="geometry" />
        </mxCell>
        <mxCell id="template-subtitle" value=".github/workflows/template-context-cleanup.yml" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#475569;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="80" y="72" width="900" height="28" as="geometry" />
        </mxCell>
        <mxCell id="template-trigger" value="Push to main&lt;br&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;GitHub also sends this event when a repository is generated from a template&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontFamily=Helvetica;fontSize=18;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="135" width="660" height="90" as="geometry" />
        </mxCell>
        <mxCell id="template-guard" value="Creation-only safety gate&lt;br&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;event.created = true · repository.is_template = false · skip source repository&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#334155;fontFamily=Helvetica;fontSize=18;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="280" width="660" height="90" as="geometry" />
        </mxCell>
        <mxCell id="template-remove" value="Remove template-specific AI context&lt;br&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Agent instruction files · README link · this cleanup workflow&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;fontColor=#7c2d12;fontFamily=Helvetica;fontSize=18;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="425" width="660" height="90" as="geometry" />
        </mxCell>
        <mxCell id="template-commit" value="Commit cleanup to generated repository&lt;br&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;GITHUB_TOKEN · contents: write · one follow-up commit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontFamily=Helvetica;fontSize=18;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="570" width="660" height="90" as="geometry" />
        </mxCell>
        <mxCell id="template-note" value="The source template keeps all AI context files. Repository rules or Actions settings that block token writes can prevent the cleanup commit." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#475569;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="250" y="710" width="1100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="template-edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="template-trigger" target="template-guard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="template-edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="template-guard" target="template-remove">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="template-edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="template-remove" target="template-commit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
