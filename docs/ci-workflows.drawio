  <diagram id="release-publishers" name="3 · Optional publishers">
    <mxGraphModel dx="1450" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" value="Optional publishing workflows" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontColor=#111827;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="35" y="18" width="1100" height="42" as="geometry" />
        </mxCell>
        <mxCell id="t3sub" value="Set the matching CI_ENABLE_*_PUBLISH option in project.mk. Enabled publishers start after the GitHub Release is published." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#475569;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="35" y="60" width="1320" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pub-start" value="&lt;b&gt;Published GitHub Release&lt;/b&gt;&lt;br&gt;Enabled downstream publisher jobs can now start" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="35" y="390" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="pub-docker" value="&lt;b&gt;publish-dockerhub&lt;/b&gt;&lt;br&gt;When enabled&lt;br&gt;Logs in, builds the Docker image, and pushes it" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="90" width="300" height="125" as="geometry" />
        </mxCell>
        <mxCell id="pub-choco" value="&lt;b&gt;publish-chocolatey&lt;/b&gt;&lt;br&gt;When enabled&lt;br&gt;Windows runner builds app assets, packs the package, and publishes it" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="285" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="pub-homebrew" value="&lt;b&gt;publish-homebrew&lt;/b&gt;&lt;br&gt;When enabled; requires PyPI success&lt;br&gt;Generates the formula and updates the Homebrew tap" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="500" width="300" height="145" as="geometry" />
        </mxCell>
        <mxCell id="pub-winget" value="&lt;b&gt;publish-winget&lt;/b&gt;&lt;br&gt;When enabled&lt;br&gt;Downloads the Windows asset, generates and validates manifests, then opens a PR to winget-pkgs" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="715" width="300" height="145" as="geometry" />
        </mxCell>
        <mxCell id="dest-docker" value="&lt;b&gt;Destination&lt;/b&gt;&lt;br&gt;Docker Hub" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="100" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dest-choco" value="&lt;b&gt;Destination&lt;/b&gt;&lt;br&gt;Chocolatey" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="305" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dest-homebrew" value="&lt;b&gt;Destination&lt;/b&gt;&lt;br&gt;Homebrew tap" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="520" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dest-winget" value="&lt;b&gt;Destination&lt;/b&gt;&lt;br&gt;Pull request to winget-pkgs" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="735" width="310" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pub-note" value="&lt;b&gt;Before enabling a publisher&lt;/b&gt;&lt;br&gt;1. Chocolatey and WinGet need the Windows app/installer settings and assets.&lt;br&gt;2. Homebrew requires PyPI publishing to be enabled and to succeed.&lt;br&gt;3. If a downstream publisher fails, the already-published GitHub Release is not rolled back." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;arcSize=12;align=left;fontSize=13;" vertex="1" parent="1">
