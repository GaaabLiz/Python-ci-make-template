<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" modified="2026-11-19T21:10:56Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="ci-ordinary" name="1 · Standard CI">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="Standard CI workflow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontColor=#111827;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="35" y="18" width="700" height="42" as="geometry" />
        </mxCell>
        <mxCell id="t1sub" value="Jobs and dependencies in .github/workflows/ci.yml" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#475569;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="35" y="60" width="1050" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ci-event" value="&lt;b&gt;CI triggers&lt;/b&gt;&lt;br&gt;Push to any branch&lt;br&gt;Pull request: opened, synchronize, reopened&lt;br&gt;Merge queue: checks_requested&lt;br&gt;Manual dispatch&lt;br&gt;Reusable call from release" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="35" y="350" width="230" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ci-lint" value="&lt;b&gt;workflow-lint&lt;/b&gt;&lt;br&gt;Ubuntu runner&lt;br&gt;Checks every workflow file with actionlint&lt;br&gt;&lt;i&gt;Runs independently&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="95" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ci-config" value="&lt;b&gt;ci-config&lt;/b&gt;&lt;br&gt;Reads and validates project.mk&lt;br&gt;Exports Python version, test OS list, uv version, and release-notes path" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="380" width="270" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ci-quality" value="&lt;b&gt;quality&lt;/b&gt;&lt;br&gt;Ubuntu runner&lt;br&gt;Starts after ci-config&lt;br&gt;Installs dev tools and runs make ci-quality" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="750" y="190" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ci-tests" value="&lt;b&gt;tests&lt;/b&gt;&lt;br&gt;Starts after ci-config&lt;br&gt;Runs the configured Python version on each OS in the test matrix&lt;br&gt;Runs make ci-test" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="750" y="430" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ci-package" value="&lt;b&gt;build-package&lt;/b&gt;&lt;br&gt;Ubuntu runner&lt;br&gt;Waits for ci-config, quality, and tests to succeed&lt;br&gt;On version tags, verifies the tag and adds ReleaseNotes.md to the PyPI package description&lt;br&gt;Smoke-tests wheel and sdist, then uploads python-package-dist and (on tags) release-notes" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1190" y="300" width="310" height="210" as="geometry" />
        </mxCell>
        <mxCell id="ci-note" value="&lt;b&gt;Release artifact&lt;/b&gt;&lt;br&gt;&lt;code&gt;python-package-dist&lt;/code&gt; contains the wheel and source archive. The release workflow downloads it for PyPI and the GitHub Release." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;arcSize=12;align=left;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1190" y="520" width="310" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ci-legend" value="&lt;b&gt;How to read this page&lt;/b&gt;&lt;br&gt;1. Any listed event starts the workflow. &lt;code&gt;workflow-lint&lt;/code&gt; checks the workflow files on its own.&lt;br&gt;2. &lt;code&gt;ci-config&lt;/code&gt; reads the project settings. Then &lt;code&gt;quality&lt;/code&gt; and &lt;code&gt;tests&lt;/code&gt; run in parallel.&lt;br&gt;3. Tests use one configured Python version across the operating systems in the test matrix.&lt;br&gt;4. &lt;code&gt;build-package&lt;/code&gt; starts only after configuration, quality checks, and every test job succeed. On ordinary runs, &lt;code&gt;make build&lt;/code&gt; serially runs &lt;code&gt;clean&lt;/code&gt; → &lt;code&gt;gen-project-module&lt;/code&gt; → &lt;code&gt;build-uv&lt;/code&gt;. The standalone &lt;code&gt;build-uv&lt;/code&gt; target remains available." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;arcSize=12;fontSize=12;align=left;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="35" y="675" width="1500" height="190" as="geometry" />
        </mxCell>
        <mxCell id="ce1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="ci-event" target="ci-lint">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="140" y="270" />
              <mxPoint x="320" y="270" />
              <mxPoint x="320" y="155" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ce2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ci-event" target="ci-config">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ci-config" target="ci-quality">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="690" y="450" />
              <mxPoint x="690" y="260" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ce4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ci-config" target="ci-tests">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.22;" edge="1" parent="1" source="ci-quality" target="ci-package">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1080" y="260" /><mxPoint x="1080" y="340" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ce6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.61;" edge="1" parent="1" source="ci-tests" target="ci-package">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1100" y="505" /><mxPoint x="1100" y="410" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ce7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.83;" edge="1" parent="1" source="ci-config" target="ci-package">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="485" y="640" /><mxPoint x="1150" y="640" /><mxPoint x="1150" y="450" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ce8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ci-package" target="ci-note">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="release-dag" name="2 · Release flow">
    <mxGraphModel dx="1900" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" value="Release workflow: main flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontColor=#111827;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="35" y="18" width="900" height="42" as="geometry" />
        </mxCell>
        <mxCell id="t2sub" value="After CI passes, the draft release, optional docs PR, native builds, and PyPI publishing run independently." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#475569;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="35" y="60" width="1650" height="30" as="geometry" />
        </mxCell>
        <mxCell id="rel-tag" value="&lt;b&gt;Push a version tag&lt;/b&gt;&lt;br&gt;&lt;code&gt;v1.2.3&lt;/code&gt;" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="400" width="150" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rel-config" value="&lt;b&gt;ci-config&lt;/b&gt;&lt;br&gt;Reads release settings from project.mk&lt;br&gt;Validates build and publisher options&lt;br&gt;Checks the tag is on RELEASE_TARGET_BRANCH" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="370" width="190" height="160" as="geometry" />
        </mxCell>
        <mxCell id="rel-gate" value="&lt;b&gt;ci-gate&lt;/b&gt;&lt;br&gt;Calls the reusable CI workflow&lt;br&gt;Workflow lint + quality + tests + package build&lt;br&gt;Uploads &lt;code&gt;python-package-dist&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="455" y="365" width="220" height="170" as="geometry" />
        </mxCell>
        <mxCell id="rel-fork" value="&lt;b&gt;Start&lt;/b&gt;&lt;br&gt;parallel jobs&lt;br&gt;using ci-config outputs" style="hexagon;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="705" y="400" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rel-changelog" value="&lt;b&gt;release-notes-and-draft&lt;/b&gt;&lt;br&gt;Downloads ReleaseNotes.md generated by ci-gate.&lt;br&gt;Creates the draft GitHub Release with those notes as its body." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="80" width="280" height="125" as="geometry" />
        </mxCell>
        <mxCell id="rel-linux" value="&lt;b&gt;build-linux&lt;/b&gt;&lt;br&gt;Runs when &lt;code&gt;CI_BUILD_LINUX=1&lt;/code&gt;&lt;br&gt;Builds and uploads Linux app assets" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=2;arcSize=12;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="850" y="235" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rel-macos" value="&lt;b&gt;build-macos&lt;/b&gt;&lt;br&gt;Runs when &lt;code&gt;CI_BUILD_MACOS=1&lt;/code&gt;&lt;br&gt;Builds and uploads macOS app assets" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=2;arcSize=12;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="850" y="385" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rel-windows" value="&lt;b&gt;build-windows&lt;/b&gt;&lt;br&gt;Runs when &lt;code&gt;CI_BUILD_WINDOWS=1&lt;/code&gt;&lt;br&gt;Builds and uploads Windows app assets" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=2;arcSize=12;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="850" y="535" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rel-pypi" value="&lt;b&gt;publish-pypi&lt;/b&gt;&lt;br&gt;Runs when &lt;code&gt;CI_ENABLE_PYPI_PUBLISH=1&lt;/code&gt;&lt;br&gt;Downloads the wheel and sdist from ci-gate, then publishes them to PyPI.&lt;br&gt;The package description includes this release's notes.&lt;br&gt;&lt;b&gt;Does not wait for native builds.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="705" width="280" height="170" as="geometry" />
        </mxCell>
        <mxCell id="rel-docs" value="&lt;b&gt;publish-release-docs&lt;/b&gt;&lt;br&gt;Runs when &lt;code&gt;CI_ENABLE_RELEASE_DOCS=1&lt;/code&gt;&lt;br&gt;Generates API docs and opens or updates a PR&lt;br&gt;&lt;b&gt;Does not gate the release.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=2;arcSize=12;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="850" y="890" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rel-ready" value="&lt;b&gt;release-ready&lt;/b&gt;&lt;br&gt;Requires valid configuration, passed ci-gate, draft release, and all native build jobs.&lt;br&gt;Enabled build: must succeed.&lt;br&gt;Disabled build: its skip is accepted." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1190" y="290" width="250" height="190" as="geometry" />
        </mxCell>
        <mxCell id="rel-publish" value="&lt;b&gt;publish-release&lt;/b&gt;&lt;br&gt;Waits for release-ready and PyPI (if enabled).&lt;br&gt;Downloads the package, ReleaseNotes.md, and enabled app assets, then publishes the GitHub Release." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1530" y="340" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="rel-outcome" value="&lt;b&gt;Important:&lt;/b&gt; PyPI publishing and native builds are independent after ci-gate. A native build failure does not block PyPI, but it keeps the GitHub Release as a draft. If PyPI is disabled, the release can publish after release-ready. ReleaseNotes.md is included in the PyPI package description and attached to the GitHub Release." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;arcSize=12;align=left;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="850" y="1030" width="980" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rel-legend" value="&lt;b&gt;How to read the release flow&lt;/b&gt;&lt;br&gt;1. The local &lt;code&gt;release-*-tag&lt;/code&gt; target bumps and generates metadata, commits and pushes the release branch, then tags that pushed commit. Pushing the tag starts configuration and the reusable CI gate; ci-config verifies the tag is on RELEASE_TARGET_BRANCH.&lt;br&gt;2. CI verifies the tag version, generates ReleaseNotes.md, then builds and checks the Python packages with those notes in their PyPI description.&lt;br&gt;3. After CI passes, draft notes, optional docs, enabled native builds, and PyPI publishing run independently.&lt;br&gt;4. Dashed orange boxes are optional: native builds follow the matching &lt;code&gt;CI_BUILD_*&lt;/code&gt; setting and API docs follow &lt;code&gt;CI_ENABLE_RELEASE_DOCS=1&lt;/code&gt;.&lt;br&gt;5. &lt;code&gt;release-ready&lt;/code&gt; joins the draft release and native-build results. The final GitHub Release waits for this gate and for PyPI when enabled. The API-docs PR does not gate the release." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;spacing=10;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;arcSize=12;align=left;fontSize=13;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="745" width="780" height="200" as="geometry" />
        </mxCell>
        <mxCell id="re1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rel-tag" target="rel-config">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rel-config" target="rel-gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rel-gate" target="rel-fork">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rel-fork" target="rel-changelog">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="820" y="450" />
              <mxPoint x="820" y="142.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="re5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;strokeColor=#f97316;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rel-fork" target="rel-linux">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="820" y="450" />
              <mxPoint x="820" y="295" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="re6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;strokeColor=#f97316;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rel-fork" target="rel-macos">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="820" y="450" />
              <mxPoint x="820" y="445" />
            </Array>
          </mxGeometry>
        </mxCell>
